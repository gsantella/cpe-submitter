# ── API Server ────────────────────────────────────────────────────────────────
# Port the Express API server listens on (default: 3001)
PORT=3001

# Secret used to sign session cookies. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Optional: Auth via environment variables ──────────────────────────────────
# If set, these override any credentials stored in the database.
# Useful for initial setup or account recovery if you forget your password.
# Once you set credentials through the Chapter settings page you can remove these.
# AUTH_USERNAME=officer
# AUTH_PASSWORD=your-password-here

# ── Frontend (cpe-tracker) ────────────────────────────────────────────────────
# Port the Vite dev server listens on (default: 5173)
# FRONTEND_PORT=5173

# URL of the API server that the Vite dev proxy forwards /api requests to.
# Only needed if you run the API on a non-default port.
# API_URL=http://localhost:3001

# Base path for the frontend router. Leave as "/" for local development.
# On Replit this is set automatically to the artifact's preview path.
# BASE_PATH=/
