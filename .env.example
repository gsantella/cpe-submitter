# ── Required ────────────────────────────────────────────────────────────────

# The public domain name your site will be reachable at.
# Point an A record at your server's IP before starting the stack.
# Caddy will automatically provision a Let's Encrypt TLS certificate.
# Example: cpe.yourchapter.org
DOMAIN=your-domain.com

# Long random secret used to sign session cookies.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=


# ── Optional ─────────────────────────────────────────────────────────────────

# Pre-configure sign-in credentials via environment variables.
# If set, these cannot be changed from the Chapter settings UI — useful for
# initial deployment or scripted provisioning.
# Leave commented out to set credentials through the app after first launch.
# AUTH_USERNAME=officer
# AUTH_PASSWORD=changeme
