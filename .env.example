# ── API Server ────────────────────────────────────────────────────────────────
# Port the Express API server listens on (default: 3001)
PORT=3001

# ── Frontend (cpe-tracker) ────────────────────────────────────────────────────
# Port the Vite dev server listens on (default: 5173)
# FRONTEND_PORT=5173

# URL of the API server that the Vite dev proxy forwards /api requests to.
# Only needed if you run the API on a non-default port.
# API_URL=http://localhost:3001

# Base path for the frontend router. Leave as "/" for local development.
# On Replit this is set automatically to the artifact's preview path.
# BASE_PATH=/
